							<ProtectedString name="Source"><![CDATA[------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
-- @CloneTrooper1019, 2017
-- Battle Armor
-- Touching this Battle Armor doubles you MaxHealth and heals you to full power.
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

local Players = game:GetService("Players")
local armor = script.Parent

local function makeArmor(part)
	local armorPart = part:Clone()
	if armorPart:IsA("MeshPart") then
		armorPart.TextureID = ""
	end
	
	armorPart.Name = "ARMOR_" .. part.Name
	armorPart.CanCollide = false
	armorPart.Reflectance = 1
	armorPart.BrickColor = BrickColor.new("Black")
	armorPart.Parent = part.Parent
	
	for _,v in pairs(armorPart:GetChildren()) do
		if v:IsA("JointInstance") then
			v:Destroy()
		end
	end
	
	local w = Instance.new("Weld")
	w.Part0 = part
	w.Part1 = armorPart
	w.Parent = part
	
	part.Transparency = 1
end

local function putOnArmor(humanoid)
	local char = humanoid.Parent
	if char then
		if humanoid.RigType == Enum.HumanoidRigType.R6 then
			local torso = humanoid.Torso
			if torso then
				makeArmor(torso)
			end
		elseif humanoid.RigType == Enum.HumanoidRigType.R15 then
			local upperTorso = char:FindFirstChild("UpperTorso")
			if upperTorso then
				makeArmor(upperTorso)
			end
			local lowerTorso = char:FindFirstChild("LowerTorso")
			if lowerTorso then
				makeArmor(lowerTorso)
			end
		end

		humanoid.MaxHealth = 200
		armor:Destroy()
		
		local player = Players:GetPlayerFromCharacter(humanoid.Parent)
		if player then
			local message = Instance.new("Message")
			message.Text = "You found Battle Armor!"
			message.Parent = player
			wait(5)
			message.Text = "Max Health Doubled!"
			wait(5)
			message:Destroy()
		end
	end
end

local function onTouched(hit)
	local char = hit.Parent
	if char then
		local humanoid = char:FindFirstChild("Humanoid")
		if humanoid and humanoid.MaxHealth <= 100 then
			putOnArmor(humanoid)
		end
	end
end

armor.Touched:connect(onTouched)]]></ProtectedString>
